# Unconnected by default: no sessions, metrics, or account data are invented.
VITE_HUB_CONNECTED=false
# Development proxy target: the future HUB server, never the internal data server.
# The current local migration bridge can use http://127.0.0.1:3333 (the existing Next API).
# The permanent HUB will take over the same browser contracts; see docs/handoff/react-standby.md.
HUB_PROXY_TARGET=http://127.0.0.1:5556
