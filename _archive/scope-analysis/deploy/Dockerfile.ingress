# analysis-ingress — mTLS 종단 사이드카(nginx). 앱은 인증을 모른다.
#
# ── 왜 이미지를 직접 굽는가 (운영 결정 ⓐ, 2026-09-12)
#
#   측정 lane 은 EC2 호스트라 compose 가 `./nginx.conf` 와 `./certs` 를 bind mount 하고 그
#   파일들을 SSM 으로 배치했다(`/opt/scope-measurement/certs/`). **Fargate 에는 그 호스트
#   파일시스템이 없다.** stock `nginx:1.27-alpine` 을 그대로 올리면 리포의 nginx.conf 도
#   인증서도 태스크에 들어가지 않아 80 만 듣고 8443 을 안 듣는다 → NLB TCP:8443 헬스체크가
#   영구 unhealthy → 태스크 교체 → circuit breaker. (기각된 대안: EFS = 파일 주인이 리포 밖으로
#   나간다 / ALB+ACM = TLS 를 ALB 가 끝내 클라이언트 인증서가 앱 경계까지 오지 않는다 = 승인 L4 위반.)
#
#   이미지에 들어가는 것은 **설정뿐**이다. 인증서는 entrypoint 가 기동 시 태스크 롤로 받는다
#   (`deploy/ingress/entrypoint.sh` 상단 참조) — 비밀키가 ECR 레이어에 영구 보관되지 않는다.
#
# ── aws cli 를 넣는 대가와 대안
#
#   `aws-cli`(alpine community, v2)는 python 런타임을 끌고 와 레이어가 **수백 MB** 늘고, arm64
#   빌드를 QEMU 로 에뮬레이션하면 `apk add` 가 수 분 걸린다. 그래도 이것을 고른 이유:
#     ① `curl --aws-sigv4` 는 `--user "<AKID>:<SECRET>"` 로 **비밀키를 argv 에 올린다** —
#        워크스페이스 룰 secrets-handling 6 정면 위반(`ps` 는 출력 마스킹을 지나간다).
#        `curl -K -`(stdin config)로 우회할 수 있지만 SigV4 를 손으로 조립하는 경로가
#        기동 임계 경로에 남는다.
#     ② api 는 상시 desired 1 이라 pull·기동은 **배포당 1회**다. 기동 지연의 가치가 낮다.
#   ⇒ 이미지 크기나 빌드 시간이 실제로 문제가 되면 바꿀 곳은 여기 한 줄이고, 그때는
#     `-K -` 방식 SigV4 를 쓴다(argv 노출 없이).
FROM nginx:1.27-alpine

# ⚠️ 버전을 고정하지 않는다 — alpine 리포는 패치 버전을 회전시켜 고정하면 빌드가 어느 날
#    "no such package" 로 죽는다. 재현성이 필요해지면 base 이미지를 digest 로 고정하는 것이
#    맞는 층이다(패키지 버전 고정이 아니라).
RUN apk add --no-cache aws-cli jq

# 설정 정본은 **리포의 한 벌**이다 — compose(로컬)와 이 이미지(Fargate)가 같은 파일을 쓴다.
# 둘을 갈라 두면 로컬에서 통과한 설정이 라이브에서 다르게 돈다.
COPY deploy/ingress/nginx.conf /etc/nginx/nginx.conf
COPY deploy/ingress/entrypoint.sh /usr/local/bin/ingress-entrypoint.sh
RUN chmod 0755 /usr/local/bin/ingress-entrypoint.sh \
 && mkdir -p /etc/nginx/certs && chmod 0700 /etc/nginx/certs

# nginx 마스터는 root 로 남긴다(워커는 conf 의 `user` 기본값으로 강등된다). 인증서 파일을
# 0600 으로 쓰는 주체가 마스터이고, 8443 은 1024 초과라 특권이 필요하지는 않다.
EXPOSE 8443

# 컨테이너 헬스체크는 **루프백 stub_status**(8081)를 본다 — 8443 을 치면 클라이언트 인증서가
# 없어 `ssl_verify_client on` 이 400 을 돌려주므로 healthcheck 가 영구 실패한다.
# NLB 쪽은 TCP:8443 이고(핸드셰이크 전 단계) 그쪽은 정상 판정된다(infra/lib/analysis-stack.ts).
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s \
  CMD wget -q -O- http://127.0.0.1:8081/nginx_status >/dev/null 2>&1 || exit 1
STOPSIGNAL SIGQUIT
ENTRYPOINT ["/usr/local/bin/ingress-entrypoint.sh"]
