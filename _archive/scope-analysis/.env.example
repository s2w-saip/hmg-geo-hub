# Development configuration template. Keep secret values outside source control.
# See README.md for setup, required credentials and operational restrictions.
# Default engine is stub. Use core only with a dedicated DB, approved models and provider keys.
ANALYSIS_STAGE=dev
ANALYSIS_PORT=8080
ANALYSIS_STORE_DSN=postgresql://analysis:analysis@db:5432/analysis
ANALYSIS_LANE_REVISION=0.0.0-dev
ANALYSIS_ENGINE=stub
ANALYSIS_LEASE_TTL_SECONDS=1200
ANALYSIS_LEASE_HEARTBEAT_SECONDS=60
ANALYSIS_LEASE_CUMULATIVE_CAP_SECONDS=2400
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_MIN_RUNWAY_SECONDS=120
ANALYSIS_DEADLINE_GRACE_SECONDS=3600
ANALYSIS_REAP_INTERVAL_SECONDS=15
ANALYSIS_DRAIN_GRACE_SECONDS=600
ANALYSIS_SWEEP_BATCH=500
ANALYSIS_TICKET_RETENTION_DAYS=14
ANALYSIS_RETENTION_BATCH=500
ANALYSIS_MAINTENANCE_INTERVAL_SECONDS=300
ANALYSIS_CONTEXT_TABLE_KEEP=64
ANALYSIS_CONTEXT_TABLE_TRIM_BATCH=100
ANALYSIS_LLM_TOTAL_CONCURRENCY=300
ANALYSIS_WORKER_UNIT_CONCURRENCY=40
ANALYSIS_WORKER_MAX_COUNT=16
ANALYSIS_LLM_SLOT_ACQUIRE_TIMEOUT_MS=30000
ANALYSIS_LLM_HOSTING_INFLIGHT=32
# ANALYSIS_WORKER_COUNT=
ANALYSIS_LLM_CACHE_BUST=false
# ANALYSIS_LLM_CACHE_BUST_MODE=nonce
ANALYSIS_CONTEXT_FETCH_TIMEOUT_MS=60000
ANALYSIS_CONTEXT_CACHE_MAX_ENTRIES=32
ANALYSIS_CONTEXT_CACHE_MAX_BYTES=268435456
ANALYSIS_CONTEXT_DB_CACHE_ENABLED=true
ANALYSIS_CALLBACK_MAX_ATTEMPTS=5
ANALYSIS_CALLBACK_TIMEOUT_SECONDS=10
ANALYSIS_HTTP_KEEPALIVE_MS=4000
ANALYSIS_HTTP_KEEPALIVE_MAX_MS=10000
# ANALYSIS_HTTP_CONNECTIONS=
# ANALYSIS_LANE_INTERNAL_TOKEN_SECRET_ARN=arn:aws:secretsmanager:us-west-2:371056712389:secret:scope-analysis/stage/internal-token-XXXXXX
# ANALYSIS_INTERNAL_CALLBACK_TOKEN=
# ANALYSIS_INTERNAL_CONTEXT_TOKEN=
# ANALYSIS_INGRESS_CERT_SECRET_ID=scope-analysis/stage/ingress-cert
# ANALYSIS_INGRESS_CERT_DIR=/etc/nginx/certs
# ANALYSIS_MEASUREMENT_CAPACITY_URL=https://measurement-ingress.internal:8443/v1/capacity
ANALYSIS_MEASUREMENT_SAMPLE_INTERVAL_MS=30000
ANALYSIS_MEASUREMENT_SAMPLE_TIMEOUT_MS=3000
ANALYSIS_PREWARM_MEASUREMENT_QUEUE_THRESHOLD=24
ANALYSIS_PREWARM_MEASUREMENT_OLDEST_AGE_SECONDS=1200
ANALYSIS_PREWARM_WORKERS=2
# ANALYSIS_FARGATE_VCPU_QUOTA=
ANALYSIS_VCPU_RESERVE=40
ANALYSIS_MEASUREMENT_FARGATE_DESIRED=0
ANALYSIS_MEASUREMENT_FARGATE_TASK_VCPU=2
ANALYSIS_WORKER_VCPU=2
ANALYSIS_API_VCPU=0.5
ANALYSIS_WORKER_GAUGE_INTERVAL_SECONDS=15
ANALYSIS_WORKER_GAUGE_FRESHNESS_SECONDS=60
ANALYSIS_DEFERRED_STALE_AFTER_SECONDS=3600
