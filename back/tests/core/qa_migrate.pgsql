-- 레거시 인용 id 1001~1010 = ord 1~10(url = 새 원문 url), 1005 만 url 이 다르다(표류). 고아 job 은 2001·2002
INSERT INTO mig_src.qa_ref_citation (job_id, id, ord, url, ref_index, domain)
SELECT '90000000-0000-4000-8000-000000000001', 1000 + v.ord, v.ord, v.url, v.ref_index, v.domain_label
  FROM rd.v_answer_citation_raw v WHERE v.answer_key = 1;
UPDATE mig_src.qa_ref_citation SET url = 'https://drift.example/x', domain = 'drift.example' WHERE id = 1005;
