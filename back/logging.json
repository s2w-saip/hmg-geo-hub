{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "request_id": {"()": "app.core.reqid.RequestIdFilter"}
  },
  "formatters": {
    "default": {
      "format": "%(asctime)s %(levelname)s %(name)s rid=%(request_id)s %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S%z"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "default",
      "filters": ["request_id"]
    }
  },
  "loggers": {
    "hgh": {"level": "INFO", "handlers": ["stdout"], "propagate": false},
    "hgh.access": {"level": "INFO", "handlers": ["stdout"], "propagate": false},
    "uvicorn": {"level": "INFO", "handlers": ["stdout"], "propagate": false},
    "uvicorn.error": {"level": "INFO", "handlers": ["stdout"], "propagate": false},
    "uvicorn.access": {"level": "WARNING", "handlers": [], "propagate": false}
  },
  "root": {"level": "WARNING", "handlers": ["stdout"]}
}
