# --- scope API gateway (BFF, server-only) ---
# These are read ONLY in server-side code (lib/scope). They must never be
# exposed to the browser (no NEXT_PUBLIC_ prefix).

# Implementation selector: "mock" (default) runs fully without a scope key.
# Switch to "live" once a workspace key is issued — no code change required.
SCOPE_MODE=mock

# Required only when SCOPE_MODE=live:
# Single HMG workspace API key. Opens ALL HMG data — the BFF enforces role
# scoping before every call. Keep server-side only.
# SCOPE_API_KEY=
# Base URL of the scope API (e.g. https://api.scope.example).
# SCOPE_API_BASE=

# Additional scope project IDs to mirror beyond SCOPE_ROOT_PROJECT_ID. Comma
# separated UUIDs. ⚠ TEMP: 2026-06-23 도입, hmg-geo project_scope_links
# 마이그레이션 후 제거 예정. Kia Italy 같은 다중 scope 프로젝트(키/샌드박스
# × Mention/Citation)를 mirror 에 누적시키기 위한 임시 우회.
# SCOPE_EXTRA_PROJECT_IDS=

# Local mirror recovery only; these do not raise the production cron page caps.
# MIRROR_RESYNC_MAX_RUNS=50
# MIRROR_LOCAL_BUDGET_MS=21600000
# For subsequent passes, reuse resyncBefore printed by the first pass.
# MIRROR_RESYNC_BEFORE=

# Demo-only project IDs (hmg-geo projects.id, comma-separated UUIDs). For
# listed projects, getProjectKpis serves SAMPLE_KPI_SUMMARY instead of the
# live mirror aggregation — used when a project's measurement workspace
# isn't yet reachable via SCOPE_API_KEY. ⚠ TEMP — empty this env once the
# workspace mapping lands.
# DEMO_PROJECT_IDS=

# --- Supabase (auth + Postgres) ---
# hmg-geo uses Supabase as a managed Postgres + Auth provider (not as a BaaS).
# The browser never touches Supabase directly; all DB access is server-side via
# Drizzle. RLS is intentionally NOT used — authorization is enforced in the app
# layer (see data-access-security spec).

# Postgres connection string for Drizzle. Use the POOLED (transaction) connection
# string from Supabase for serverless. SERVER-ONLY — never expose to the browser.
DATABASE_URL=

# Supabase project URL and keys (used by @supabase/ssr for auth, server-side).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER-ONLY, never NEXT_PUBLIC_. Used for privileged
# server operations (e.g. seeding). Keep out of the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Analytics 4 (server-only) ---
# Used by both scripts/ga4/* (PoC probe + raw export) and the runtime
# AI 유입 전환율 KPI (lib/ga4/* → dashboard KPI #7 + /standard/ai-funnel/
# conversion when scope narrows to a mapped (brand, country) property).
# Server-only; NEVER NEXT_PUBLIC_.
#
# Setup:
#   1. Create an OAuth 2.0 "Desktop app" client in Google Cloud Console and
#      enable the "Google Analytics Data API".
#   2. Run `npm run ga4:probe` once to authorize interactively. It writes
#      refresh_token to `.ga4-token.json` (gitignored).
#   3. Copy that refresh_token value into GA4_OAUTH_REFRESH_TOKEN below so the
#      server runtime (Vercel etc.) can refresh access tokens headlessly.
# GA4_OAUTH_CLIENT_ID=
# GA4_OAUTH_CLIENT_SECRET=
# GA4_OAUTH_REFRESH_TOKEN=

# Numeric property id (NOT the G-XXXX measurement id). Used by scripts/ga4/*
# when no --property flag is passed, and as the back-compat fallback for the
# Kia/Italy mapping when GA4_PROPERTY_ID_KIA_IT is unset.
# GA4_PROPERTY_ID=

# Per-(brand, country) property mapping for the AI Conversion KPI. Add one
# env var per measured market — `lib/ga4/property-map.ts` keys off these.
# GA4_PROPERTY_ID_KIA_IT=  # kia.com/it/it — KIA-EU_ITA_NATIONAL

# --- Cron auth (Vercel) ---
# Shared secret Vercel Cron sends in Authorization: Bearer …. /api/cron/*
# refuses other callers. Server-only.
# CRON_SECRET=

# Durable bulk discovery in the existing sync cron. Enable only after migration
# 0073, reader gates, and the existing runner's mirror consumer are deployed.
# MIRROR_BULK_ENABLED=1
# The existing runner can poll the measurement-run feed without fetching prompts.
# The file retains project rotation, cursors, and at most one pending run-list
# page per project. Registration progress is replaced atomically after enqueue.
# The service wrapper enables --discover.
# MIRROR_DISCOVERY_STATE_PATH=/var/lib/hmg-runner/mirror-discovery-state.json
# MIRROR_DISCOVERY_BUDGET_MS=10000
# External mirror consumer uses the existing authenticated cache endpoint.
# HMG_INTERNAL_BASE_URL=https://app.example.com

# --- Health alert sink: GitHub Issue (server-only) ---
# /api/cron/sync-mirror 이 함께 도는 고아 프로젝트 감시(scope_project_id IS NULL,
# lib/scope/orphan-health.ts)의 알림 목적지. 사내 운영 규칙에서
# "코드·데이터를 사람이 고쳐야 해소되는" 신호는 GitHub Issue 로 간다.
#
# 둘 다 설정돼야 알림이 나간다. 미설정이면 감시는 그대로 돌되 결과가
# `alert: "unconfigured"` 로 응답·로그에 남는다 — 조용한 통과가 아니다.
#
# ⚠️ 토큰은 **fine-grained PAT, 단일 리포, Issues: Read and write 만**. repo
# 쓰기(contents)를 주지 마라 — 이 값은 웹 앱 런타임 env 에 상주한다.
# GITHUB_ALERT_TOKEN=
# GITHUB_ALERT_REPO=Kongventures/hmg-geo

# --- Live alert sink: Slack Incoming Webhook (server-only) ---
# alert-routing 룰의 다른 목적지. "지금 서비스가 아프다 · 사람이 지금 봐야 한다" 는
# 여기로 온다. 현재 쓰는 곳: /api/cron/cycle-chain-watch 의 **회차 노출 지체** 감시
# (고객 화면이 지금 낡은 회차를 내고 있다 = 라이브 이슈). 2026-09-25 잔디에서 전환(Slack 운영 알림 채널).
#
# 미설정이면 감시는 그대로 돌되 결과가 `alert: "unconfigured"` 로 응답·로그에 남는다
# : 조용한 통과가 아니다(룰 4).
#
# ⚠️ 이 URL 은 그 자체가 **발송 권한**이다(아는 사람은 누구나 그 채널에 글을 쓴다).
#    · 값은 서버 런타임 env 에만. NEXT_PUBLIC_ 금지, 리포 커밋 금지.
#    · 호스트 검증이 코드에 있다(https://hooks.slack.com/services/ 가 아니면 미배선 취급).
# SLACK_ALERT_WEBHOOK=

# --- Keyword tools (server-only) ---
# Powers /admin/keyword-tools: DataForSEO Google Ads search-volume lookup +
# OpenRouter-backed keyword→prompt generation (ported from aeorank). Both are
# PAID external APIs and admin-gated. Server-only; NEVER NEXT_PUBLIC_.
#
# DataForSEO authenticates with HTTP Basic (login:password), not a bearer key.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
#
# OpenRouter — single bearer key opens the LLM gateway used for keyword→prompt
# (and prompt→keyword extraction).
# OPENROUTER_API_KEY=
# OpenRouter model id used for generation. Optional — defaults to
# google/gemini-2.5-flash. Any OpenRouter model works (e.g. openai/gpt-4o-mini,
# anthropic/claude-3.5-haiku).
# OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Raw Data QA Console (server-only) ---
# 측정 데이터를 사람이 눈으로 검수하는 숨겨진 콘솔 /{locale}/raw-data-qa.
# (dash) 그룹 밖이라 route-policy 가드가 없고, Supabase 로그인 대신 자체 쿠키
# 게이트(lib/qa/auth.ts)로 막는다 — 검수자는 GGMD 계정이 없는 외부 인력이다.
#
# ⚠️ 이 표면은 role 스코프 경계를 **의도적으로 우회한다**: 비밀번호 하나로 미러
# 전체(글로벌·웹사이트·프로젝트)의 답변 원문과 분석 행이 열린다. 2026-09-04
# 제품 결정이며 근거는 docs/specs/2026-09-04-raw-data-qa-console-design.md §3.
# 그래서 기본값은 **꺼짐**이고, 검수 기간에만 켠다.
#
# "1" 일 때만 라우트가 존재한다. 그 외 값/미설정이면 전 경로 404 (킬 스위치).
# RAW_DATA_QA_ENABLED=1
#
# 검수자 공유 비밀번호. 미설정 시 기본값 qa-default-redacted.
# RAW_DATA_QA_PASSWORD=
#
# 세션 쿠키 HMAC 서명 키 + IP 해시 솔트. 미설정 시 프로세스 부팅마다 랜덤이라
# 재배포가 모든 검수 세션을 끊는다 — 운영에서는 반드시 채운다.
#   openssl rand -hex 32
# RAW_DATA_QA_SECRET=

# 시드 스크립트(scripts/db/seed.ts) 데모 계정 비밀번호. 코드에 두지 않는다.
# 계정별 override: SEED_PASSWORD_<이메일 로컬파트 대문자, 비영숫자는 _>
SEED_PASSWORD=

# --- hmg-geo-hub backend API (lib/hgh, server-only) ---
# 화면 데이터 함수가 옛 경로(lib/scope/server·lib/db) 대신 새 백엔드 /v1 을 부를 때 쓴다.
# 전부 서버 전용이다. NEXT_PUBLIC_ 접두 금지(토큰·비밀이 브라우저로 새면 안 된다).
#
# 백엔드 주소(CloudFront). https 필수, http 는 localhost·127.0.0.1 만 허용(로컬 E2E).
# 옛 경로만 쓰는 배포(아래 HGH_SOURCE_* 전부 legacy)에서는 비워 둬도 된다: 첫 API 호출 때 검사한다.
# HGH_API_BASE_URL=
# 분석 읽기 기본 타임아웃(ms, 기본 10000) 재정의. 관리 35s·쓰기 15s·외부 경유 70s·파일 120s 는 코드 고정.
# HGH_API_TIMEOUT_MS=
#
# 결정 D2: 검수 로그인 시도 상한을 실제 뷰어 IP 로 세게 하는 중계 비밀. 설정하면 BFF 가
# X-HGH-Client-IP(실제 IP) + X-HGH-Relay-Secret(이 값) 헤더를 붙이고, 백엔드는 비밀이 맞을 때만
# 그 IP 를 쓴다. 백엔드와 같은 값(16~256자, 공백 없는 ASCII). 미설정이면 IP 를 중계하지 않는다.
# HGH_RELAY_SECRET=
#
# 결정 D8: 화면 그룹별 데이터 원천 스위치. api | legacy, 미설정·그 밖 값 = legacy(옛 경로).
# 그룹은 통합 설계서 §6.2 전환 단계: G1 글로벌 대시보드, G2 글로벌 답변 분석·드릴다운,
# G3 웹사이트(표면 전체), G4 AI 퍼널, G5 글로벌 프롬프트, G6 프로젝트·고객 관심(프로젝트 표면 포함),
# G7 운영·검수. SESSION = 로그인 세션(/v1/auth/me). 롤백 = 값을 legacy 로 되돌리고 재배포.
# HGH_SOURCE_SESSION=legacy
# HGH_SOURCE_G1=legacy
# HGH_SOURCE_G2=legacy
# HGH_SOURCE_G3=legacy
# HGH_SOURCE_G4=legacy
# HGH_SOURCE_G5=legacy
# HGH_SOURCE_G6=legacy
# HGH_SOURCE_G7=legacy
#
# 업로드 중계 상한(바이트). 기본·최대 = 백엔드 상한 10 MiB. 호스팅 함수의 요청 본문 한도가 더 작으면
# (배포 때 확인, 결정 D7) 그 값으로 낮춰 사용자에게 한도 안내 오류를 먼저 보여 준다.
# HGH_UPLOAD_MAX_BYTES=
#
# 로컬 E2E 계측(설계 5.3). 설정했을 때만 백엔드 호출마다 JSONL 한 줄(requestId·경로·쿼리·상태·ms·
# 본문 sha256)을 이 파일에 덧붙인다. 응답 본문은 싣지 않는다. Vercel 에서는 설정해도 무시한다. 운영에 두지 않는다.
# HGH_API_TRACE_FILE=
# 값 대조용 선택 값 파일(위 계측이 켜져 있을 때만). 형식 {"<경로 템플릿>": ["json.경로", ...]},
# 예 {"/v1/kpi/summary": ["data.cards[0].visibility.num", "data.cards.length"]}. 스칼라와 배열 길이만 기록한다
# (문자열 200자 절단, 객체·배열 값은 "<non-scalar>"). E2E 하네스가 screens.json 에서 만든다.
# HGH_API_TRACE_SELECT=
#
# OpenAPI 타입 재생성(scripts/gen-api-types.mjs)에 쓸 파이썬. 기본 <repo>/back/.venv/bin/python, 없으면 python3.
# HGH_BACK_PYTHON=
