# Local Gold reader. No browser-side DB credentials; every page needs the HUB login (manage.py set-admin).
HGH_LOCAL_READ_ONLY=1
HGH_API_BASE_URL=http://127.0.0.1:5556
# Extra hosts besides loopback (comma-separated, e.g. a VM's LAN IP); pages there still need the HUB login.
# HGH_LOCAL_ALLOWED_HOSTS=
HGH_API_TIMEOUT_MS=20000
NEXT_TELEMETRY_DISABLED=1
HGH_SOURCE_SESSION=api
HGH_SOURCE_G1=api
HGH_SOURCE_G2=api
HGH_SOURCE_G3=api
HGH_SOURCE_G4=api
HGH_SOURCE_G5=api
HGH_SOURCE_G6=api
HGH_SOURCE_G7=api
