  "text": "
    WITH names AS (
  SELECT r.entity_id, r.brand,
         (CASE r.brand WHEN $1 THEN $2 WHEN $3 THEN $4 WHEN $5 THEN $6 WHEN $7 THEN $8 WHEN $9 THEN $10 WHEN $11 THEN $12 WHEN $13 THEN $14 WHEN $15 THEN $16 WHEN $17 THEN $18 WHEN $19 THEN $20 WHEN $21 THEN $22 WHEN $23 THEN $24 WHEN $25 THEN $26 WHEN $27 THEN $28 WHEN $29 THEN $30 WHEN $31 THEN $32 WHEN $33 THEN $34 WHEN $35 THEN $36 WHEN $37 THEN $38 WHEN $39 THEN $40 WHEN $41 THEN $42 WHEN $43 THEN $44 WHEN $45 THEN $46 WHEN $47 THEN $48 WHEN $49 THEN $50 WHEN $51 THEN $52 WHEN $53 THEN $54 WHEN $55 THEN $56 WHEN $57 THEN $58 WHEN $59 THEN $60 WHEN $61 THEN $62 WHEN $63 THEN $64 WHEN $65 THEN $66 WHEN $67 THEN $68 WHEN $69 THEN $70 WHEN $71 THEN $72 WHEN $73 THEN $74 WHEN $75 THEN $76 ELSE r.brand END) AS cname,
         lower(btrim((CASE r.brand WHEN $77 THEN $78 WHEN $79 THEN $80 WHEN $81 THEN $82 WHEN $83 THEN $84 WHEN $85 THEN $86 WHEN $87 THEN $88 WHEN $89 THEN $90 WHEN $91 THEN $92 WHEN $93 THEN $94 WHEN $95 THEN $96 WHEN $97 THEN $98 WHEN $99 THEN $100 WHEN $101 THEN $102 WHEN $103 THEN $104 WHEN $105 THEN $106 WHEN $107 THEN $108 WHEN $109 THEN $110 WHEN $111 THEN $112 WHEN $113 THEN $114 WHEN $115 THEN $116 WHEN $117 THEN $118 WHEN $119 THEN $120 WHEN $121 THEN $122 WHEN $123 THEN $124 WHEN $125 THEN $126 WHEN $127 THEN $128 WHEN $129 THEN $130 WHEN $131 THEN $132 WHEN $133 THEN $134 WHEN $135 THEN $136 WHEN $137 THEN $138 WHEN $139 THEN $140 WHEN $141 THEN $142 WHEN $143 THEN $144 WHEN $145 THEN $146 WHEN $147 THEN $148 WHEN $149 THEN $150 WHEN $151 THEN $152 ELSE r.brand END), $153)) AS bare
  FROM (
  WITH RECURSIVE _rn_pairs AS (
    (SELECT m.entity_id, m.brand FROM scope_mentions m
      WHERE m.entity_type = 'Brand' AND m.brand IS NOT NULL
      ORDER BY m.entity_id, m.brand LIMIT 1)
    UNION ALL
    SELECT nx.entity_id, nx.brand FROM _rn_pairs p
    CROSS JOIN LATERAL (
      SELECT m.entity_id, m.brand FROM scope_mentions m
      WHERE m.entity_type = 'Brand' AND m.brand IS NOT NULL
        AND (m.entity_id, m.brand) > (p.entity_id, p.brand)
      ORDER BY m.entity_id, m.brand LIMIT 1
    ) nx
  )
  SELECT DISTINCT ON (entity_id) entity_id, brand
  FROM _rn_pairs ORDER BY entity_id, (brand ~ '^[A-Za-z]') DESC, brand
) r
),
    ans AS MATERIALIZED (
      SELECT DISTINCT ON (a.prompt_id, a.target, a.region, COALESCE(_cw.cycle_week, (date_trunc('week', a.measured_at))::date))
        a.job_id, COALESCE(_cw.cycle_week, (date_trunc('week', a.measured_at))::date) AS wk
      FROM scope_answers a LEFT JOIN (
        SELECT cr.run_id, c.cycle_week
        FROM summary_cycle_runs cr JOIN summary_cycles c ON c.cycle_id = cr.cycle_id
      ) _cw ON _cw.run_id = a.run_id
      WHERE a.measured_at IS NOT NULL AND a.measured_at >= now() - interval '120 days' AND a.status = 'completed' AND true AND a.run_id IN (SELECT run_id FROM scope_runs WHERE true) AND a.measured_at >= $154::date AND a.measured_at < ($155::date + 1) AND a.prompt_id IN (SELECT scope_prompt_id FROM prompts WHERE project_id = $156 AND scope_prompt_id IS NOT NULL) AND true
      ORDER BY a.prompt_id, a.target, a.region, COALESCE(_cw.cycle_week, (date_trunc('week', a.measured_at))::date),
        a.measured_at DESC
    )
    SELECT to_char(x.wk, 'YYYY-MM-DD') AS day,
      COALESCE(n.cname, (CASE x.brand WHEN $157 THEN $158 WHEN $159 THEN $160 WHEN $161 THEN $162 WHEN $163 THEN $164 WHEN $165 THEN $166 WHEN $167 THEN $168 WHEN $169 THEN $170 WHEN $171 THEN $172 WHEN $173 THEN $174 WHEN $175 THEN $176 WHEN $177 THEN $178 WHEN $179 THEN $180 WHEN $181 THEN $182 WHEN $183 THEN $184 WHEN $185 THEN $186 WHEN $187 THEN $188 WHEN $189 THEN $190 WHEN $191 THEN $192 WHEN $193 THEN $194 WHEN $195 THEN $196 WHEN $197 THEN $198 WHEN $199 THEN $200 WHEN $201 THEN $202 WHEN $203 THEN $204 WHEN $205 THEN $206 WHEN $207 THEN $208 WHEN $209 THEN $210 WHEN $211 THEN $212 WHEN $213 THEN $214 WHEN $215 THEN $216 WHEN $217 THEN $218 WHEN $219 THEN $220 WHEN $221 THEN $222 WHEN $223 THEN $224 WHEN $225 THEN $226 WHEN $227 THEN $228 WHEN $229 THEN $230 WHEN $231 THEN $232 ELSE x.brand END)) AS key,
      sum(x.mention_count)::int AS n
    FROM (
      SELECT ans.wk AS wk, m.mention_count AS mention_count, m.brand AS brand,
        (CASE WHEN m.brand_rollup_entity_id IS NULL THEN m.brand_rollup_entity_id WHEN m.brand ~* $233 THEN $234 WHEN m.brand ~* $235 THEN $236 WHEN m.brand ~* $237 THEN $238 ELSE (CASE m.brand_rollup_entity_id WHEN $239 THEN $240 WHEN $241 THEN $242 WHEN $243 THEN $244 WHEN $245 THEN $246 WHEN $247 THEN $248 WHEN $249 THEN $250 WHEN $251 THEN $252 ELSE m.brand_rollup_entity_id END) END) AS rid
      FROM scope_mentions m JOIN ans ON ans.job_id = m.job_id
      WHERE m.brand_rollup_entity_id IS NOT NULL
      OFFSET 0
    ) x
    LEFT JOIN names n ON n.entity_id = x.rid
    WHERE COALESCE(n.brand, x.brand) IS NOT NULL
      AND (CASE COALESCE(n.bare, lower(btrim((CASE x.brand WHEN $253 THEN $254 WHEN $255 THEN $256 WHEN $257 THEN $258 WHEN $259 THEN $260 WHEN $261 THEN $262 WHEN $263 THEN $264 WHEN $265 THEN $266 WHEN $267 THEN $268 WHEN $269 THEN $270 WHEN $271 THEN $272 WHEN $273 THEN $274 WHEN $275 THEN $276 WHEN $277 THEN $278 WHEN $279 THEN $280 WHEN $281 THEN $282 WHEN $283 THEN $284 WHEN $285 THEN $286 WHEN $287 THEN $288 WHEN $289 THEN $290 WHEN $291 THEN $292 WHEN $293 THEN $294 WHEN $295 THEN $296 WHEN $297 THEN $298 WHEN $299 THEN $300 WHEN $301 THEN $302 WHEN $303 THEN $304 WHEN $305 THEN $306 WHEN $307 THEN $308 WHEN $309 THEN $310 WHEN $311 THEN $312 WHEN $313 THEN $314 WHEN $315 THEN $316 WHEN $317 THEN $318 WHEN $319 THEN $320 WHEN $321 THEN $322 WHEN $323 THEN $324 WHEN $325 THEN $326 WHEN $327 THEN $328 ELSE x.brand END), $329))) WHEN $330 THEN (x.brand ~* $331) WHEN $332 THEN (x.brand ~* $333) WHEN $334 THEN (x.brand ~* $335) WHEN $336 THEN (x.brand ~* $337) WHEN $338 THEN (x.brand ~* $339) WHEN $340 THEN (x.brand ~* $341) WHEN $342 THEN (x.brand ~* $343) WHEN $344 THEN (x.brand ~* $345) WHEN $346 THEN (x.brand ~* $347) WHEN $348 THEN (x.brand ~* $349) WHEN $350 THEN (x.brand ~* $351) WHEN $352 THEN (x.brand ~* $353) WHEN $354 THEN (x.brand ~* $355) WHEN $356 THEN (x.brand ~* $357) WHEN $358 THEN (x.brand ~* $359) WHEN $360 THEN (x.brand ~* $361) WHEN $362 THEN (x.brand ~* $363) WHEN $364 THEN (x.brand ~* $365) WHEN $366 THEN (x.brand ~* $367) WHEN $368 THEN (x.brand ~* $369) WHEN $370 THEN (x.brand ~* $371) WHEN $372 THEN (x.brand ~* $373) WHEN $374 THEN (x.brand ~* $375) WHEN $376 THEN (x.brand ~* $377) WHEN $378 THEN (x.brand ~* $379) WHEN $380 THEN (x.brand ~* $381) WHEN $382 THEN (x.brand ~* $383) ELSE COALESCE(n.bare, lower(btrim((CASE x.brand WHEN $384 THEN $385 WHEN $386 THEN $387 WHEN $388 THEN $389 WHEN $390 THEN $391 WHEN $392 THEN $393 WHEN $394 THEN $395 WHEN $396 THEN $397 WHEN $398 THEN $399 WHEN $400 THEN $401 WHEN $402 THEN $403 WHEN $404 THEN $405 WHEN $406 THEN $407 WHEN $408 THEN $409 WHEN $410 THEN $411 WHEN $412 THEN $413 WHEN $414 THEN $415 WHEN $416 THEN $417 WHEN $418 THEN $419 WHEN $420 THEN $421 WHEN $422 THEN $423 WHEN $424 THEN $425 WHEN $426 THEN $427 WHEN $428 THEN $429 WHEN $430 THEN $431 WHEN $432 THEN $433 WHEN $434 THEN $435 WHEN $436 THEN $437 WHEN $438 THEN $439 WHEN $440 THEN $441 WHEN $442 THEN $443 WHEN $444 THEN $445 WHEN $446 THEN $447 WHEN $448 THEN $449 WHEN $450 THEN $451 WHEN $452 THEN $453 WHEN $454 THEN $455 WHEN $456 THEN $457 WHEN $458 THEN $459 ELSE x.brand END), $460))) NOT IN ($461, $462, $463, $464, $465, $466, $467, $468, $469, $470, $471, $472, $473, $474, $475, $476, $477, $478, $479, $480, $481, $482, $483, $484, $485, $486, $487, $488, $489, $490, $491, $492, $493, $494, $495, $496, $497, $498, $499, $500, $501, $502, $503, $504, $505, $506, $507, $508, $509, $510, $511, $512, $513, $514, $515, $516, $517, $518, $519, $520, $521, $522, $523, $524, $525, $526, $527, $528, $529, $530, $531, $532, $533, $534, $535, $536, $537, $538, $539, $540, $541, $542, $543, $544, $545, $546, $547, $548, $549, $550, $551, $552, $553, $554, $555, $556, $557, $558, $559, $560, $561, $562, $563, $564, $565, $566, $567, $568, $569, $570, $571, $572, $573, $574, $575, $576, $577, $578, $579, $580, $581, $582, $583, $584, $585, $586, $587, $588, $589, $590, $591, $592, $593, $594, $595, $596, $597, $598, $599, $600, $601, $602, $603, $604, $605, $606, $607, $608, $609, $610, $611, $612, $613, $614, $615, $616, $617, $618) END)
      true
    GROUP BY 1, 2
  ",
}
`;

