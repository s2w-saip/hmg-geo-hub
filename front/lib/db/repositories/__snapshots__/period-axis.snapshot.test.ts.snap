exports[`snapshotRunFilter — JS 미러 경로(드릴다운) > 루트 · cumulative+기간 1`] = `
{
  "params": [
    "2026-08-20",
    "2026-09-04",
    "2026-08-20",
    "2026-09-04",
    "26751906-c175-485c-9e69-29fc68d0fdbb",
  ],
  "text": "status = 'completed' AND (run_id IN (SELECT run_id FROM scope_runs WHERE true AND cycle_anchor_at IS NOT NULL AND cycle_anchor_at >= $1::date AND cycle_anchor_at < ($2::date + 1)) OR (run_id IN (SELECT run_id FROM scope_runs WHERE true AND cycle_anchor_at IS NULL) AND measured_at >= $3::date AND measured_at < ($4::date + 1))) AND true AND prompt_id IN (SELECT scope_prompt_id FROM prompts WHERE project_id = $5 AND scope_prompt_id IS NOT NULL)",
}
`;

exports[`snapshotRunFilter — JS 미러 경로(드릴다운) > 루트 · 기간 없음 1`] = `
{
  "params": [
    "26751906-c175-485c-9e69-29fc68d0fdbb",
  ],
  "text": "job_id IN (
    WITH _fc_base AS (
      SELECT a.job_id, a.prompt_id, a.target, a.region, a.measured_at,
        (r.started_at >= now() - interval '7 days') AS in_window
      FROM scope_answers a
      JOIN scope_runs r ON r.run_id = a.run_id
      WHERE true AND r.status IN ('completed', 'partial_failed') AND a.status = 'completed'
        
        AND NOT (
    a.region <> 'KR'
    AND a.prompt_id IS NOT NULL
    AND a.prompt_id IN (SELECT sp.prompt_id FROM scope_prompts sp WHERE sp.text ~ '[가-힣]')
  )
        
    ),
    _fc_cells AS (
      SELECT prompt_id, target, region, bool_or(in_window) AS w,
        min(measured_at) AS first_at,
        max(measured_at) FILTER (WHERE in_window) AS w_last
      FROM _fc_base GROUP BY 1, 2, 3
    ),
    -- ── 기대 셀을 "이번 창에 실제로 돈 셀"로 한정 (2026-09-04, #188) ──────────
    -- expected 는 원래 이력 무제한이었다. 그래서 한 시장의 측정이 멈추면 그 셀이
    -- 기대치에 영구히 남고 window 가 절대 따라잡지 못해, 그 시장을 커버하는
    -- 프롬프트가 **다른 시장에서까지 통째로** 탈락했다(2026-09-04 EG 실증:
    -- 마지막 측정 8/25 인 EG 셀 2개 때문에 AE Hyundai 프롬프트 208개가 fail).
    -- 고침: 창 안에 한 건도 측정되지 않은 (엔진, 국가) 셀은 기대치에서 뺀다.
    -- 그 시장은 돌았는데 이 프롬프트만 빠진 경우는 셀이 active 에 남아 여전히 탈락한다.
    -- main 의 원안(#188)은 이 목록을 scope_answers 재스캔으로 얻었지만, 같은
    -- 술어의 창 안 행은 이미 _fc_base.in_window 에 있으므로 셀 집계에서 파생한다
    -- (스캔 1회 유지 — 아래 단일 스캔 주석의 전제).
    _fc_active AS (
      SELECT DISTINCT target, region FROM _fc_cells WHERE w
    ),
    -- ── 창 끝 이후에 처음 생긴 셀은 기대치에서 뺀다 (2026-09-28) ──────────────
    -- expected 는 이력 무제한이라 **미래**도 본다. 프롬프트에 시장이 나중에 추가되면
    -- (2026-09-28 scope 가 743개 프롬프트에 IN·AU·GB·MY·SA·TH·ID 등을 태깅) 그 새 셀이
    -- 과거 창의 기대치에 들어가, 과거 창을 조회할 때 그 프롬프트가 "셀 부족"으로 탈락한다.
    -- 위 _fc_active 한정(#188)은 그 시장이 **다른 프롬프트로** 창 안에서 측정됐으면 못 막는다
    -- (IN·AU·GB 등은 다른 프롬프트로 매 회차 돈다).
    -- 고침: 셀의 최초 completed 측정 시각(first_at)이 창 안 마지막 측정(w_last 의 최대)보다
    -- 뒤면 그 셀은 "이 창 시점에 아직 없던 셀"이므로 기대치에서 뺀다.
    --   · 창 판정 술어(windowPredicate)는 불투명하므로 창 무관 정의를 쓴다 — 창 끝 = 창 안
    --     행의 measured_at 최대. 창 경계를 SQL 로 다시 해석하지 않는다.
    --   · 대칭: 창 안 셀(w)은 first_at <= 자기 w_last <= 창 끝 이라 절대 빠지지 않는다.
    --     즉 이 절은 **창 밖 셀만** 뺀다 — window 쪽 집계는 불변이다.
    --   · 창 끝은 _fc_cells 에서 파생한다(_fc_base 를 다시 읽지 않는다 — materialize 된
    --     CTE 의 세 번째 참조를 만들지 않기 위해). 스캔 1회 구조는 그대로다.
    --   · NULL 은 종전대로 둔다: 창 안 셀(w)은 무조건 유지, measured_at 이 전부 NULL 인
    --     셀(first_at NULL)도 유지, 창 끝을 모르면(w_last 전부 NULL) 아무것도 빼지 않는다.
    -- 프로덕션 미러 실측(2026-09-28, 읽기 전용): 루트 회차 5개 + 기본 7일 창 전부에서 종전
    -- 게이트 통과 프롬프트 중 탈락 0. 노출 게이트를 끈 9/13·9/20 창에서는 종전 게이트가
    -- 9/27 회차에 새로 생긴 셀 때문에 기아 EN 2개를 떨어뜨렸고(11,408) 이 절이 되살렸다.
    -- EXPLAIN (ANALYZE, BUFFERS) 기본 7일 창 교차 4회 중앙값 596.6 → 626.0 ms(+4.9%, ID 해제로
    -- 늘어난 행 포함) · scope_answers 스캔 1회 · _fc_base 참조 2회 그대로.
    _fc_gate AS (
      SELECT prompt_id FROM _fc_cells c
      WHERE (c.target, c.region) IN (SELECT target, region FROM _fc_active)
        AND (c.w OR c.first_at IS NULL
          OR c.first_at <= (SELECT COALESCE(max(w_last), 'infinity'::timestamptz) FROM _fc_cells))
      GROUP BY prompt_id
      HAVING count(*) FILTER (WHERE w) >= count(*)
    )
    SELECT DISTINCT ON (b.prompt_id, b.target, b.region) b.job_id
    FROM _fc_base b
    JOIN _fc_gate g ON g.prompt_id = b.prompt_id
    WHERE b.in_window
    ORDER BY b.prompt_id, b.target, b.region, b.measured_at DESC
  ) AND true AND prompt_id IN (SELECT scope_prompt_id FROM prompts WHERE project_id = $1 AND scope_prompt_id IS NOT NULL)",
}
`;

exports[`snapshotRunFilter — JS 미러 경로(드릴다운) > 프로젝트 · cumulative+기간 1`] = `
{
  "params": [
    [
      "11111111-1111-4111-8111-111111111111",
    ],
    "2026-08-20",
    "2026-09-04",
    [
      "11111111-1111-4111-8111-111111111111",
    ],
    "2026-08-20",
    "2026-09-04",
  ],
  "text": "status = 'completed' AND (run_id IN (SELECT run_id FROM scope_runs WHERE project_id = ANY($1::uuid[]) AND cycle_anchor_at IS NOT NULL AND cycle_anchor_at >= $2::date AND cycle_anchor_at < ($3::date + 1)) OR (run_id IN (SELECT run_id FROM scope_runs WHERE project_id = ANY($4::uuid[]) AND cycle_anchor_at IS NULL) AND measured_at >= $5::date AND measured_at < ($6::date + 1))) AND true",
}
`;

exports[`snapshotRunFilter — JS 미러 경로(드릴다운) > 프로젝트 · dateFrom+dateTo 1`] = `
{
  "params": [
    [
      "11111111-1111-4111-8111-111111111111",
    ],
    "2026-08-20",
    "2026-09-04",
    [
      "11111111-1111-4111-8111-111111111111",
    ],
    "2026-08-20",
    "2026-09-04",
  ],
  "text": "job_id IN (
    SELECT DISTINCT ON (a.prompt_id, a.target, a.region) a.job_id
    FROM scope_answers a
    JOIN scope_runs r ON r.run_id = a.run_id
    JOIN (
      SELECT r.project_id, max(a.measured_at) - interval '7 days' AS floor_at
      FROM scope_answers a
      JOIN scope_runs r ON r.run_id = a.run_id
      WHERE r.project_id = ANY($1::uuid[])
        AND r.status IN ('completed', 'partial_failed')
        AND a.status = 'completed' AND COALESCE(r.cycle_anchor_at, r.started_at) >= $2::date AND COALESCE(r.cycle_anchor_at, r.started_at) < ($3::date + 1)
      GROUP BY r.project_id
    ) pm ON pm.project_id = r.project_id
    WHERE r.project_id = ANY($4::uuid[])
      AND r.status IN ('completed', 'partial_failed')
      AND a.status = 'completed' AND COALESCE(r.cycle_anchor_at, r.started_at) >= $5::date AND COALESCE(r.cycle_anchor_at, r.started_at) < ($6::date + 1)
      AND a.measured_at >= pm.floor_at
    ORDER BY a.prompt_id, a.target, a.region, a.measured_at DESC
  ) AND true",
}
`;

