bstr(lower(btrim(coalesce(c.url, ''), E' \\t\\n\\r')), CASE WHEN starts_with(lower(btrim(coalesce(c.url, ''), E' \\t\\n\\r')), 'https://') THEN 9 WHEN starts_with(lower(btrim(coalesce(c.url, ''), E' \\t\\n\\r')), 'http://') THEN 8 ELSE 1 END), nullif(strpos(substr(lower(btrim(coalesce(c.url, ''), E' \\t\\n\\r')), CASE WHEN starts_with(lower(btrim(coalesce(c.url, ''), E' \\t\\n\\r')), 'https://') THEN 9 WHEN starts_with(lower(btrim(coalesce(c.url, ''), E' \\t\\n\\r')), 'http://') THEN 8 ELSE 1 END), '/'), 0)), ''), '?', 1), '#', 1), '%40', '@')) || '/', $24) THEN $25 WHEN starts_with((lower(c.domain) || replace(split_part(split_part(coalesce(substr(substr(lower(btrim(coalesce(c.url, ''), E' \\t\\n\\r')), CASE WHEN starts_with(lower(btrim(coalesce(c.url, ''), E' \\t\\n\\r')), 'https://') THEN 9 WHEN starts_with(lower(btrim(coalesce(c.url, ''), E' \\t\\n\\r')), 'http://') THEN 8 ELSE 1 END), nullif(strpos(substr(lower(btrim(coalesce(c.url, ''), E' \\t\\n\\r')), CASE WHEN starts_with(lower(btrim(coalesce(c.url, ''), E' \\t\\n\\r')), 'https://') THEN 9 WHEN starts_with(lower(btrim(coalesce(c.url, ''), E' \\t\\n\\r')), 'http://') THEN 8 ELSE 1 END), '/'), 0)), ''), '?', 1), '#', 1), '%40', '@')) || '/', $26) THEN $27 ELSE lower(c.domain) END
    ) ELSE lower(c.domain) END AS domain, c.category, a.target, CASE WHEN lower(c.domain) IN ($28) THEN rtrim(split_part(split_part(regexp_replace(regexp_replace(lower(btrim(c.url, E' 	

')), '^https?://', ''), '^www\\.', ''), '?', 1), '#', 1), '/') END AS base
        FROM scope_citations c JOIN scope_answers a ON a.job_id = c.job_id
        WHERE true AND a.job_id IN (
    SELECT DISTINCT ON (a.prompt_id, a.target, a.region) a.job_id
    FROM scope_answers a
    JOIN scope_runs r ON r.run_id = a.run_id
    JOIN (
      SELECT r.project_id, max(a.measured_at) - interval '7 days' AS floor_at
      FROM scope_answers a
      JOIN scope_runs r ON r.run_id = a.run_id
      WHERE r.project_id = ANY($29::uuid[])
        AND r.status IN ('completed', 'partial_failed')
        AND a.status = 'completed'
      GROUP BY r.project_id
    ) pm ON pm.project_id = r.project_id
    WHERE r.project_id = ANY($30::uuid[])
      AND r.status IN ('completed', 'partial_failed')
      AND a.status = 'completed'
      AND a.measured_at >= pm.floor_at
    ORDER BY a.prompt_id, a.target, a.region, a.measured_at DESC
  ) AND c.domain IS NOT NULL
      )
      SELECT domain, category, target,
        count(*)::int AS citations,
        -- COALESCE: 비후보 도메인 그룹은 base 가 전행 NULL → bool_or 가 NULL.
        COALESCE(bool_or((((split_part(base, '/', 1) = ANY(ARRAY[$31]::text[]) AND ((base = ANY(ARRAY[$32]::text[]) OR base LIKE ANY(ARRAY[$33]::text[]) OR base = ANY(ARRAY[$34]::text[])))) OR base IN (
    SELECT DISTINCT rtrim(split_part(split_part(regexp_replace(regexp_replace(lower(btrim(wp.target_url, E' 	

')), '^https?://', ''), '^www\\.', ''), '?', 1), '#', 1), '/') AS turl
    FROM website_prompts wp
    JOIN website_sites ws ON ws.id = wp.site_id
    WHERE ws.scope_project_id::text = ANY($35::text[]) AND wp.target_url <> '')) OR (NULLIF(base, '') IS NULL AND domain ~* $36))), false) AS owned,
        -- 행 단위 owned 카운트 (KPI ⑤ 분자 규칙) — 공식(당사) 타일의 분자.
        count(*) FILTER (WHERE (((split_part(base, '/', 1) = ANY(ARRAY[$37]::text[]) AND ((base = ANY(ARRAY[$38]::text[]) OR base LIKE ANY(ARRAY[$39]::text[]) OR base = ANY(ARRAY[$40]::text[])))) OR base IN (
    SELECT DISTINCT rtrim(split_part(split_part(regexp_replace(regexp_replace(lower(btrim(wp.target_url, E' 	

')), '^https?://', ''), '^www\\.', ''), '?', 1), '#', 1), '/') AS turl
    FROM website_prompts wp
    JOIN website_sites ws ON ws.id = wp.site_id
    WHERE ws.scope_project_id::text = ANY($41::text[]) AND wp.target_url <> '')) OR (NULLIF(base, '') IS NULL AND domain ~* $42)))::int AS owned_citations
      FROM c2 GROUP BY domain, category, target
    

