    WITH ans AS MATERIALIZED (
      SELECT DISTINCT ON (a.prompt_id, a.target, a.region, date_trunc('week', a.measured_at))
        a.job_id, date_trunc('week', a.measured_at) AS wk
      FROM scope_answers a
      WHERE a.measured_at IS NOT NULL
        AND a.measured_at >= now() - interval '120 days' AND a.status = 'completed' AND true AND a.run_id IN (SELECT run_id FROM scope_runs WHERE project_id = ANY($1::uuid[])) AND true AND NOT EXISTS (
    SELECT 1 FROM summary_cycle_runs cr
      JOIN summary_cycles c ON c.cycle_id = cr.cycle_id
     WHERE cr.run_id = a.run_id
       AND (c.hidden_reason IS NOT NULL OR CASE c.surface
         WHEN $2 THEN COALESCE(
           c.view_anchor_at, c.cycle_anchor_at + interval '2 days'
         ) > now() WHEN $3 THEN COALESCE(
           c.view_anchor_at, c.cycle_anchor_at + interval '1 day'
         ) > now()
         ELSE c.status IN ($4)
       END)
  )
      ORDER BY a.prompt_id, a.target, a.region, date_trunc('week', a.measured_at),
        a.measured_at DESC
