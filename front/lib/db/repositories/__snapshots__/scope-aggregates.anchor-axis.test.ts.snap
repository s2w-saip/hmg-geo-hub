exports[`ACR(앵커 축 on) — job_id 가 없어 run 축으로 붙는다 > acrWhere · 기간 없음 1`] = `
{
  "params": [],
  "text": "true AND x.run_id IN (SELECT ca.run_id FROM scope_answer_cycle_anchors ca WHERE ca.round_date = (SELECT max(ca2.round_date) FROM scope_answer_cycle_anchors ca2 WHERE ca2.surface = 'standard' AND ca2.view_anchor_date IS NOT NULL
      AND ca2.view_anchor_date <= hmg_anchor_today() AND true AND (ca2.surface = 'project' OR EXISTS (
    SELECT 1 FROM summary_cycles sc
     WHERE sc.cycle_id = ca2.cycle_id
       AND sc.fleet_visible
       AND sc.view_anchor_at IS NOT NULL AND sc.view_anchor_at <= now()
       AND sc.active_generation_id IS NOT NULL
  ))) AND ca.view_anchor_date IS NOT NULL
      AND ca.view_anchor_date <= hmg_anchor_today() AND true AND (ca.surface = 'project' OR EXISTS (
    SELECT 1 FROM summary_cycles sc
     WHERE sc.cycle_id = ca.cycle_id
       AND sc.fleet_visible
       AND sc.view_anchor_at IS NOT NULL AND sc.view_anchor_at <= now()
       AND sc.active_generation_id IS NOT NULL
  )))",
}
`;

