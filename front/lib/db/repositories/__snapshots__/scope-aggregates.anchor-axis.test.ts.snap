  "text": "
    WITH names AS (
  SELECT r.entity_id, r.brand,
         (CASE r.brand WHEN $1 THEN $2 WHEN $3 THEN $4 WHEN $5 THEN $6 WHEN $7 THEN $8 WHEN $9 THEN $10 WHEN $11 THEN $12 WHEN $13 THEN $14 WHEN $15 THEN $16 WHEN $17 THEN $18 WHEN $19 THEN $20 WHEN $21 THEN $22 WHEN $23 THEN $24 WHEN $25 THEN $26 WHEN $27 THEN $28 WHEN $29 THEN $30 WHEN $31 THEN $32 WHEN $33 THEN $34 WHEN $35 THEN $36 WHEN $37 THEN $38 WHEN $39 THEN $40 WHEN $41 THEN $42 WHEN $43 THEN $44 WHEN $45 THEN $46 WHEN $47 THEN $48 WHEN $49 THEN $50 WHEN $51 THEN $52 WHEN $53 THEN $54 WHEN $55 THEN $56 WHEN $57 THEN $58 WHEN $59 THEN $60 WHEN $61 THEN $62 WHEN $63 THEN $64 WHEN $65 THEN $66 WHEN $67 THEN $68 WHEN $69 THEN $70 WHEN $71 THEN $72 WHEN $73 THEN $74 WHEN $75 THEN $76 ELSE r.brand END) AS cname,
         lower(btrim((CASE r.brand WHEN $77 THEN $78 WHEN $79 THEN $80 WHEN $81 THEN $82 WHEN $83 THEN $84 WHEN $85 THEN $86 WHEN $87 THEN $88 WHEN $89 THEN $90 WHEN $91 THEN $92 WHEN $93 THEN $94 WHEN $95 THEN $96 WHEN $97 THEN $98 WHEN $99 THEN $100 WHEN $101 THEN $102 WHEN $103 THEN $104 WHEN $105 THEN $106 WHEN $107 THEN $108 WHEN $109 THEN $110 WHEN $111 THEN $112 WHEN $113 THEN $114 WHEN $115 THEN $116 WHEN $117 THEN $118 WHEN $119 THEN $120 WHEN $121 THEN $122 WHEN $123 THEN $124 WHEN $125 THEN $126 WHEN $127 THEN $128 WHEN $129 THEN $130 WHEN $131 THEN $132 WHEN $133 THEN $134 WHEN $135 THEN $136 WHEN $137 THEN $138 WHEN $139 THEN $140 WHEN $141 THEN $142 WHEN $143 THEN $144 WHEN $145 THEN $146 WHEN $147 THEN $148 WHEN $149 THEN $150 WHEN $151 THEN $152 ELSE r.brand END), $153)) AS bare
  FROM (
  WITH RECURSIVE _rn_pairs AS (
    (SELECT m.entity_id, m.brand FROM scope_mentions m
      WHERE m.entity_type = 'Brand' AND m.brand IS NOT NULL
      ORDER BY m.entity_id, m.brand LIMIT 1)
    UNION ALL
    SELECT nx.entity_id, nx.brand FROM _rn_pairs p
    CROSS JOIN LATERAL (
      SELECT m.entity_id, m.brand FROM scope_mentions m
      WHERE m.entity_type = 'Brand' AND m.brand IS NOT NULL
        AND (m.entity_id, m.brand) > (p.entity_id, p.brand)
      ORDER BY m.entity_id, m.brand LIMIT 1
    ) nx
  )
  SELECT DISTINCT ON (entity_id) entity_id, brand
  FROM _rn_pairs ORDER BY entity_id, (brand ~ '^[A-Za-z]') DESC, brand
) r
),
    ans AS MATERIALIZED (
      SELECT DISTINCT ON (ca.round_date, a.prompt_id, a.target, a.region)
        a.job_id, ca.anchor_week AS wk
      FROM scope_answers a JOIN scope_answer_cycle_anchors ca ON ca.job_id = a.job_id
      WHERE a.measured_at IS NOT NULL AND a.measured_at >= now() - interval '120 days' AND true AND true
      ORDER BY ca.round_date, a.prompt_id, a.target, a.region,
        ca.measured_at_orig DESC, a.job_id DESC
    )
    SELECT to_char(x.wk, 'YYYY-MM-DD') AS day,
      COALESCE(n.cname, (CASE x.brand WHEN $154 THEN $155 WHEN $156 THEN $157 WHEN $158 THEN $159 WHEN $160 THEN $161 WHEN $162 THEN $163 WHEN $164 THEN $165 WHEN $166 THEN $167 WHEN $168 THEN $169 WHEN $170 THEN $171 WHEN $172 THEN $173 WHEN $174 THEN $175 WHEN $176 THEN $177 WHEN $178 THEN $179 WHEN $180 THEN $181 WHEN $182 THEN $183 WHEN $184 THEN $185 WHEN $186 THEN $187 WHEN $188 THEN $189 WHEN $190 THEN $191 WHEN $192 THEN $193 WHEN $194 THEN $195 WHEN $196 THEN $197 WHEN $198 THEN $199 WHEN $200 THEN $201 WHEN $202 THEN $203 WHEN $204 THEN $205 WHEN $206 THEN $207 WHEN $208 THEN $209 WHEN $210 THEN $211 WHEN $212 THEN $213 WHEN $214 THEN $215 WHEN $216 THEN $217 WHEN $218 THEN $219 WHEN $220 THEN $221 WHEN $222 THEN $223 WHEN $224 THEN $225 WHEN $226 THEN $227 WHEN $228 THEN $229 ELSE x.brand END)) AS key,
      sum(x.mention_count)::int AS n
    FROM (
      SELECT ans.wk AS wk, m.mention_count AS mention_count, m.brand AS brand,
        (CASE WHEN m.brand_rollup_entity_id IS NULL THEN m.brand_rollup_entity_id WHEN m.brand ~* $230 THEN $231 WHEN m.brand ~* $232 THEN $233 WHEN m.brand ~* $234 THEN $235 ELSE (CASE m.brand_rollup_entity_id WHEN $236 THEN $237 WHEN $238 THEN $239 WHEN $240 THEN $241 WHEN $242 THEN $243 WHEN $244 THEN $245 WHEN $246 THEN $247 WHEN $248 THEN $249 ELSE m.brand_rollup_entity_id END) END) AS rid
      FROM scope_mentions m JOIN ans ON ans.job_id = m.job_id
      WHERE m.brand_rollup_entity_id IS NOT NULL
      OFFSET 0
    ) x
    LEFT JOIN names n ON n.entity_id = x.rid
    WHERE COALESCE(n.brand, x.brand) IS NOT NULL
      AND (CASE COALESCE(n.bare, lower(btrim((CASE x.brand WHEN $250 THEN $251 WHEN $252 THEN $253 WHEN $254 THEN $255 WHEN $256 THEN $257 WHEN $258 THEN $259 WHEN $260 THEN $261 WHEN $262 THEN $263 WHEN $264 THEN $265 WHEN $266 THEN $267 WHEN $268 THEN $269 WHEN $270 THEN $271 WHEN $272 THEN $273 WHEN $274 THEN $275 WHEN $276 THEN $277 WHEN $278 THEN $279 WHEN $280 THEN $281 WHEN $282 THEN $283 WHEN $284 THEN $285 WHEN $286 THEN $287 WHEN $288 THEN $289 WHEN $290 THEN $291 WHEN $292 THEN $293 WHEN $294 THEN $295 WHEN $296 THEN $297 WHEN $298 THEN $299 WHEN $300 THEN $301 WHEN $302 THEN $303 WHEN $304 THEN $305 WHEN $306 THEN $307 WHEN $308 THEN $309 WHEN $310 THEN $311 WHEN $312 THEN $313 WHEN $314 THEN $315 WHEN $316 THEN $317 WHEN $318 THEN $319 WHEN $320 THEN $321 WHEN $322 THEN $323 WHEN $324 THEN $325 ELSE x.brand END), $326))) WHEN $327 THEN (x.brand ~* $328) WHEN $329 THEN (x.brand ~* $330) WHEN $331 THEN (x.brand ~* $332) WHEN $333 THEN (x.brand ~* $334) WHEN $335 THEN (x.brand ~* $336) WHEN $337 THEN (x.brand ~* $338) WHEN $339 THEN (x.brand ~* $340) WHEN $341 THEN (x.brand ~* $342) WHEN $343 THEN (x.brand ~* $344) WHEN $345 THEN (x.brand ~* $346) WHEN $347 THEN (x.brand ~* $348) WHEN $349 THEN (x.brand ~* $350) WHEN $351 THEN (x.brand ~* $352) WHEN $353 THEN (x.brand ~* $354) WHEN $355 THEN (x.brand ~* $356) WHEN $357 THEN (x.brand ~* $358) WHEN $359 THEN (x.brand ~* $360) WHEN $361 THEN (x.brand ~* $362) WHEN $363 THEN (x.brand ~* $364) WHEN $365 THEN (x.brand ~* $366) WHEN $367 THEN (x.brand ~* $368) WHEN $369 THEN (x.brand ~* $370) WHEN $371 THEN (x.brand ~* $372) WHEN $373 THEN (x.brand ~* $374) WHEN $375 THEN (x.brand ~* $376) WHEN $377 THEN (x.brand ~* $378) WHEN $379 THEN (x.brand ~* $380) ELSE COALESCE(n.bare, lower(btrim((CASE x.brand WHEN $381 THEN $382 WHEN $383 THEN $384 WHEN $385 THEN $386 WHEN $387 THEN $388 WHEN $389 THEN $390 WHEN $391 THEN $392 WHEN $393 THEN $394 WHEN $395 THEN $396 WHEN $397 THEN $398 WHEN $399 THEN $400 WHEN $401 THEN $402 WHEN $403 THEN $404 WHEN $405 THEN $406 WHEN $407 THEN $408 WHEN $409 THEN $410 WHEN $411 THEN $412 WHEN $413 THEN $414 WHEN $415 THEN $416 WHEN $417 THEN $418 WHEN $419 THEN $420 WHEN $421 THEN $422 WHEN $423 THEN $424 WHEN $425 THEN $426 WHEN $427 THEN $428 WHEN $429 THEN $430 WHEN $431 THEN $432 WHEN $433 THEN $434 WHEN $435 THEN $436 WHEN $437 THEN $438 WHEN $439 THEN $440 WHEN $441 THEN $442 WHEN $443 THEN $444 WHEN $445 THEN $446 WHEN $447 THEN $448 WHEN $449 THEN $450 WHEN $451 THEN $452 WHEN $453 THEN $454 WHEN $455 THEN $456 ELSE x.brand END), $457))) NOT IN ($458, $459, $460, $461, $462, $463, $464, $465, $466, $467, $468, $469, $470, $471, $472, $473, $474, $475, $476, $477, $478, $479, $480, $481, $482, $483, $484, $485, $486, $487, $488, $489, $490, $491, $492, $493, $494, $495, $496, $497, $498, $499, $500, $501, $502, $503, $504, $505, $506, $507, $508, $509, $510, $511, $512, $513, $514, $515, $516, $517, $518, $519, $520, $521, $522, $523, $524, $525, $526, $527, $528, $529, $530, $531, $532, $533, $534, $535, $536, $537, $538, $539, $540, $541, $542, $543, $544, $545, $546, $547, $548, $549, $550, $551, $552, $553, $554, $555, $556, $557, $558, $559, $560, $561, $562, $563, $564, $565, $566, $567, $568, $569, $570, $571, $572, $573, $574, $575, $576, $577, $578, $579, $580, $581, $582, $583, $584, $585, $586, $587, $588, $589, $590, $591, $592, $593, $594, $595, $596, $597, $598, $599, $600, $601, $602, $603, $604, $605, $606, $607, $608, $609, $610, $611, $612, $613, $614, $615) END)
      true
    GROUP BY 1, 2
  ",
}
`;
