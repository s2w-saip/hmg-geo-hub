{
  "$comment": "Screen list for the local E2E (design 5.3, 5.4). One entry per screen, one Playwright test per case: title '<id> <case name>' (run one with -g '<id>'). A screen with no cases is a placeholder for a later unit and is reported as skipped. sourceFlags = groups whose HGH_SOURCE_<group>=api is set on next dev by stack.sh (add your group when your unit converts). serverCallBudget (defaults, or per screen with a budgetNote) = the most backend /v1 calls in flight at once while the page loads, judged on visit cases expecting ok from the tap's [start, end) spans (design G-25: 5+ concurrent calls per screen saturate the backend; D6: essentials first); the total number of calls and their waves are recorded, not judged. Field reference: ScreenDef and CaseDef in e2e/harness.ts.",
  "sourceFlags": ["SESSION", "G1", "G2", "G3", "G4", "G5", "G6", "G7"],
  "defaults": { "locale": "ko", "serverCallBudget": 4 },
  "screens": [
    {
      "id": "login-landing",
      "unit": "U2",
      "title": "로그인 착지",
      "flow": "login",
      "path": "/ko/login",
      "leaf": "legacy",
      "relay": "bearer",
      "apis": ["GET /v1/auth/me"],
      "ready": ["aside[aria-label='Secondary navigation']", "[aria-label='Primary']"],
      "note": "Real login form -> mock auth password grant -> login action GET /v1/auth/me with the new token -> defaultLandingFor. The landing page content is a later unit (legacy), only the layout is checked.",
      "cases": [
        { "account": "ADMIN", "expect": "ok", "landing": "/ko/dashboard" },
        { "account": "VENDOR", "expect": "ok", "landing": "/ko/projects" },
        { "account": "WEBSITE_KIA", "expect": "ok", "landing": "/ko/website" },
        { "account": "SUSPENDED", "expect": "login", "apiStatus": { "GET /v1/auth/me": 401 } },
        { "name": "bad-password", "account": "ADMIN", "password": "wrong", "expect": "login-error", "errorText": "login.error", "apis": [] }
      ]
    },
    {
      "id": "dash-layout",
      "unit": "U2",
      "title": "(dash) 레이아웃 GNB·SNB",
      "flow": "visit",
      "path": "/ko/no-access",
      "relay": "bearer",
      "apis": ["GET /v1/auth/me"],
      "ready": ["aside[aria-label='Secondary navigation']", "[aria-label='Primary']"],
      "note": "/no-access is a static leaf under the (dash) layout, so session, route guard, GNB rail and SNB are checked without any later-unit data.",
      "cases": [
        { "account": "ADMIN", "expect": "ok", "rail": ["/dashboard", "/website", "/projects", "/admin"] },
        { "account": "HQ_HYUNDAI", "expect": "ok", "rail": ["/dashboard", "/projects"] },
        { "account": "KIA_US", "expect": "ok", "rail": ["/dashboard", "/website", "/projects"] },
        { "account": "VENDOR", "expect": "ok", "rail": ["/projects"] },
        { "account": "WEBSITE_KIA", "expect": "ok", "rail": ["/website"] },
        { "account": "SUSPENDED", "expect": "login", "apiStatus": { "GET /v1/auth/me": 401 } },
        { "name": "anonymous", "account": null, "expect": "login", "apis": [] }
      ]
    },
    {
      "id": "session-refresh",
      "unit": "U2",
      "title": "세션 갱신(짧은 토큰)",
      "flow": "refresh",
      "path": "/ko/no-access",
      "relay": "bearer",
      "apis": ["GET /v1/auth/me"],
      "ready": ["aside[aria-label='Secondary navigation']"],
      "note": "Token lifetime 30 s (inside supabase-js's 90 s expiry margin) makes every getSession refresh: middleware refresh, server-component read of the pre-refresh cookie (reuse grace) and the backend still see a valid token.",
      "cases": [{ "account": "KIA_EU", "expect": "ok", "expIn": 30 }]
    },
    {
      "id": "project-gate",
      "unit": "U2",
      "title": "프로젝트 게이트",
      "flow": "visit",
      "path": "/ko/projects/c0000000-0000-4000-8000-000000000003",
      "leaf": "legacy",
      "relay": "bearer",
      "apis": ["GET /v1/auth/me", "GET /v1/projects/{project_id}"],
      "ready": ["aside[aria-label='Secondary navigation']"],
      "values": [
        { "route": "/v1/projects/{project_id}", "jsonPath": "data.name", "selector": "aside[aria-label='Secondary navigation']", "match": "contains" }
      ],
      "note": "Layout gate GET /v1/projects/{id}: admin or active member passes (SNB project header = API name), anyone else 404. The project dashboard under it is U5 (legacy).",
      "cases": [
        { "account": "ADMIN", "expect": "ok" },
        { "account": "VENDOR", "expect": "ok" },
        { "name": "VENDOR-root", "account": "VENDOR", "path": "/ko/projects/c0000000-0000-4000-8000-000000000001", "expect": "not-found", "apiStatus": { "GET /v1/projects/{project_id}": 404 } },
        { "account": "HQ_HYUNDAI", "expect": "not-found", "apiStatus": { "GET /v1/projects/{project_id}": 404 } },
        { "account": "WEBSITE_KIA", "expect": "no-access", "apis": ["GET /v1/auth/me"], "apiStatus": { "GET /v1/projects/{project_id}": 404 } },
        { "name": "ADMIN-missing", "account": "ADMIN", "path": "/ko/projects/c0000000-0000-4000-8000-0000000000ff", "expect": "not-found", "apiStatus": { "GET /v1/projects/{project_id}": 404 } }
      ]
    },
    {
      "id": "qa-gate",
      "unit": "U12",
      "title": "검수 콘솔 게이트",
      "flow": "qaGate",
      "path": "/ko/raw-data-qa",
      "relay": "qa",
      "apis": ["POST /v1/qa/sessions"],
      "ready": ["table"],
      "note": "Browser carries the ADMIN Supabase session too, so the relay check proves sb-* cookies and Authorization never reach /v1/qa/*.",
      "cases": [
        { "account": "ADMIN", "expect": "ok", "landing": "/ko/raw-data-qa/answers", "reviewer": "e2e-gate" },
        { "name": "bad-password", "account": "ADMIN", "password": "wrong", "expect": "qa-error", "reviewer": "e2e-gate", "errorText": "qaReview.gate.errorCredentials", "apiStatus": { "POST /v1/qa/sessions": 401 }, "apis": [] }
      ]
    },
    {
      "id": "qa-list",
      "unit": "U12",
      "title": "검수 목록",
      "flow": "visit",
      "path": "/ko/raw-data-qa/answers",
      "relay": "qa",
      "apis": ["GET /v1/qa/sessions/current", "GET /v1/qa/answers", "GET /v1/qa/answers/progress", "GET /v1/qa/filters"],
      "ready": ["table tbody tr"],
      "values": [{ "route": "/v1/qa/answers", "jsonPath": "data.items.length", "selector": "table tbody tr", "match": "count" }],
      "cases": [
        { "account": "QA", "expect": "ok" },
        { "name": "QA-noMentions", "account": "QA", "path": "/ko/raw-data-qa/answers?noMentions=1", "expect": "ok", "query": { "GET /v1/qa/answers": { "no_mentions": ["true"] }, "GET /v1/qa/answers/progress": { "no_mentions": ["true"] } } },
        { "name": "no-qa-cookie", "account": "ADMIN", "expect": "qa-gate", "apis": [] }
      ]
    },
    {
      "id": "qa-detail",
      "unit": "U12",
      "title": "검수 상세",
      "flow": "visit",
      "path": "/ko/raw-data-qa/answers/{jobId}",
      "relay": "qa",
      "apis": [
        "GET /v1/qa/sessions/current",
        "GET /v1/qa/answers/{job_id}",
        "GET /v1/qa/answers/{job_id}/review",
        "GET /v1/qa/answers/{job_id}/notes",
        "GET /v1/qa/answers/{job_id}/neighbors",
        "POST /v1/qa/answers/{job_id}/lock"
      ],
      "ready": ["main"],
      "values": [{ "route": "/v1/qa/answers/{job_id}", "jsonPath": "data.prompt.text", "selector": "main", "match": "contains", "prefix": 40 }],
      "cases": [
        { "account": "QA", "expect": "ok", "resolve": { "var": "jobId", "from": "/ko/raw-data-qa/answers", "route": "/v1/qa/answers", "jsonPath": "data.items[0].job_id" } },
        { "name": "QA-missing", "account": "QA", "path": "/ko/raw-data-qa/answers/00000000-0000-4000-8000-000000000000", "expect": "not-found", "apis": ["GET /v1/qa/answers/{job_id}"], "apiStatus": { "GET /v1/qa/answers/{job_id}": 404 } }
      ]
    },
    {
      "id": "qa-note",
      "unit": "U12",
      "title": "검수 노트 작성",
      "flow": "qaNote",
      "path": "/ko/raw-data-qa/answers/{jobId}",
      "relay": "qa",
      "apis": ["POST /v1/qa/answers/{job_id}/notes"],
      "cases": [
        { "account": "QA", "expect": "ok", "noteBody": "e2e note: answer check", "resolve": { "var": "jobId", "from": "/ko/raw-data-qa/answers", "route": "/v1/qa/answers", "jsonPath": "data.items[0].job_id" } }
      ]
    },
    {
      "id": "qa-notes",
      "unit": "U12",
      "title": "검수 노트 모아보기",
