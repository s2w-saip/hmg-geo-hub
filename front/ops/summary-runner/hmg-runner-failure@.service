[Unit]
Description=hmg-geo runner failure notifier (%i)
Documentation=https://github.com/Kongventures/hmg-geo
# 알림이 나가려면 네트워크가 있어야 한다. 실패 유닛이 네트워크 문제로 죽었다면
# 여기도 못 나갈 수 있다 — 그 경우는 회차 사슬 감시(앱 크론)가 적체로 잡는다.
After=network-online.target

[Service]
Type=oneshot
# ⚠️ User= 를 두지 않는다(= root). 이유가 둘이다:
#   ① `journalctl -u <unit>` 로 실패 직전 로그를 읽어야 한다.
#   ② 인스턴스 롤(IMDS)로 Secrets Manager 를 읽는 데 권한 상승이 필요 없다.
# 대신 쓰기 경로를 최소로 잠근다(아래 하드닝).

# ARN 은 비밀이 아니다(포인터). 값은 스크립트가 인스턴스 롤로 직독한다 —
# 유닛 파일에도, EnvironmentFile 에도, 디스크 어디에도 값이 남지 않는다.
Environment=SLACK_SECRET_ARN=__SLACK_SECRET_ARN__

# `%i` = 실패한 유닛 이름. `OnFailure=hmg-runner-failure@%n.service` 가 넣어 준다.
ExecStart=/opt/hmg-runner/bin/notify-failure.sh %i

# 알림 자체가 오래 붙들려 있으면 안 된다. 실패하면 journal 에 남고 끝이다 —
# 재시도는 다음 실패가 한다(같은 실패가 계속되면 알림도 계속 온다).
TimeoutStartSec=60
Restart=no

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/hmg-runner
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hmg-runner-failure
