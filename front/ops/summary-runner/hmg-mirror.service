[Unit]
Description=hmg-geo resumable bulk mirror consumer
After=network-online.target
Wants=network-online.target
# Restart=always 라 실패해도 다시 뜨지만, **왜 계속 뜨는지**는 아무도 안 본다.
# OnFailure 는 재시작 정책과 무관하게 실패 전이마다 부른다.
OnFailure=hmg-runner-failure@%n.service

[Service]
Type=simple
User=hmgrunner
Group=hmgrunner
WorkingDirectory=__MIRROR_RELEASE_DIR__
Environment=MIRROR_APP_ROOT=__MIRROR_RELEASE_DIR__
# Replace pointers only after reviewing the existing runner's secret access.
Environment=DB_SECRET_ARN=__DB_SECRET_ARN__
Environment=CRON_SECRET_ARN=__CRON_SECRET_ARN__
Environment=SCOPE_API_KEY_SECRET_ARN=__SCOPE_API_KEY_SECRET_ARN__
Environment=SCOPE_API_BASE=__SCOPE_API_BASE__
Environment=SCOPE_ROOT_PROJECT_ID=__SCOPE_ROOT_PROJECT_ID__
Environment=HMG_INTERNAL_BASE_URL=__HMG_INTERNAL_BASE_URL__
ExecStart=/usr/bin/bash __MIRROR_RELEASE_DIR__/ops/summary-runner/run-mirror.sh
Restart=always
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=90
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/hmg-runner
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hmg-mirror

[Install]
WantedBy=multi-user.target
